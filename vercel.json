    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/shop.html", "destination": "/shop", "permanent": true },
    { "source": "/product.html", "destination": "/product", "permanent": true },
    { "source": "/custom.html", "destination": "/custom", "permanent": true },
    { "source": "/cart.html", "destination": "/cart", "permanent": true },
    { "source": "/checkout.html", "destination": "/checkout", "permanent": true },
    { "source": "/order-sent.html", "destination": "/order-sent", "permanent": true },
    { "source": "/track.html", "destination": "/track", "permanent": true },
    { "source": "/admin.html", "destination": "/admin", "permanent": true }
  ],
  "rewrites": [
    { "source": "/shop", "destination": "/shop.html" },
    { "source": "/product", "destination": "/product.html" },
    { "source": "/custom", "destination": "/custom.html" },
    { "source": "/cart", "destination": "/cart.html" },
    { "source": "/checkout", "destination": "/checkout.html" },
    { "source": "/order-sent", "destination": "/order-sent.html" },
